# Database (default works inside devcontainer; use localhost when running on host)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@pdf-viewer-db:5432/pdf-viewer-postgres

# CORS origins (optional)
CORS_ORIGINS=["*"]

# Storage backend: local or s3
STORAGE_BACKEND=local

# Local: base directory from server root when relative
STORAGE_BASE_PATH=uploads

# S3 settings (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=
